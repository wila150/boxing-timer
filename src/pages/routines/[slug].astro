---
import Base from '../../layouts/Base.astro';
import Timer from '../../components/Timer.astro';
import data from '../../data/routines.json';

export function getStaticPaths() {
  return data.routines.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cat = data.categories.find((c) => c.id === r.cat)!;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const TYPE: Record<string, string> = { prepare: '準備', work: '訓練', rest: '休息' };
let at = 0;
const steps = r.segments.map((s: any) => { const row = { ...s, at }; at += s.dur; return row; });
const others = data.routines.filter((x) => x.cat === r.cat && x.slug !== r.slug).concat(data.routines.filter((x) => x.cat !== r.cat)).slice(0, 4);
const routine = { name: r.name, segments: r.segments, warn: r.warn, half: false, theme: r.theme, combo: r.combo };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: r.name,
  description: r.summary,
  totalTime: `PT${Math.floor(r.total / 60)}M${r.total % 60}S`,
  tool: r.equip.split('、').map((t: string) => ({ '@type': 'HowToTool', name: t })),
  step: r.segments.filter((s: any) => s.type === 'work').map((s: any, i: number) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.how || s.name })),
};
---
<Base title={`${r.name}｜${cat.name}計時器｜RoundBell`} description={r.summary} htmlClass="routine-page" jsonLd={jsonLd}>
  <Timer routine={routine} />
  <article class="below wrap">
    <p class="crumb"><a href={base + 'routines/'}>課表</a> › <a href={base + 'routines/#' + cat.id}>{cat.name}</a></p>
    <h1 class="page-h1">{r.name}</h1>
    <p class="lead">{r.summary}</p>
    <div class="meta big"><span>⏱ 總長 {fmt(r.total)}</span><span>{r.level}</span><span>{r.equip}</span>{r.combo.on && <span>🥊 教練喊拳（{r.combo.level === 'adv' ? '進階' : '基礎'}）</span>}</div>
    <div class="actions">
      <button class="btn-red" id="saveRoutine">＋ 加入我的課表</button>
      <button class="btn-ghost" id="shareRoutine">🔗 複製分享連結</button>
    </div>

    <h2>動作步驟與時間軸</h2>
    <ol class="timeline">
      {steps.map((s: any) => (
        <li class={'t-' + s.type}>
          <time>{fmt(s.at)}</time>
          <div><b>{s.type === 'work' ? s.name : TYPE[s.type] + (s.name && s.name !== TYPE[s.type] ? '・' + s.name : '')}</b><span class="dur">{s.dur} 秒</span>{s.how && s.type === 'work' && <p>{s.how}</p>}</div>
        </li>
      ))}
      <li class="t-end"><time>{fmt(r.total)}</time><div><b>完成 🏁</b></div></li>
    </ol>

    <h2>小提醒</h2>
    <ul class="tips">{r.tips.map((t: string) => <li>{t}</li>)}</ul>

    <h2>其他課表</h2>
    <div class="cards">
      {others.map((o) => <a class="card" href={base + 'routines/' + o.slug + '/'}><h3>{o.name}</h3><p>{o.summary}</p></a>)}
    </div>
  </article>
</Base>
