---
import '../styles/global.css';
interface Props { title: string; description: string; bodyClass?: string }
const { title, description, bodyClass = 's-idle' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(base + 'img/icon-512.png', Astro.site)}>
<meta name="theme-color" content="#0e0e0e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="RoundBell">
<link rel="manifest" href={base + 'manifest.webmanifest'}>
<link rel="icon" href={base + 'img/icon.svg'} type="image/svg+xml">
<link rel="apple-touch-icon" href={base + 'img/apple-touch-icon.png'}>
</head>
<body class={bodyClass}>
<slot />
</body>
</html>
